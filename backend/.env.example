# String de conexão pooled (para queries normais)
DATABASE_URL="postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# String de conexão direta (para migrations)
DIRECT_URL="postgresql://postgres.SEU_PROJECT_REF:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# JWT secret do Supabase (Settings → API → JWT Secret)
SUPABASE_JWT_SECRET="seu-jwt-secret-aqui"

# Porta do servidor
PORT=3001

# Origem permitida para CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5175"
